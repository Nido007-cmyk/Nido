    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-jest": "30.5.2",
    "jest": "30.5.2",
    "node-llama-cpp": "3.22.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:pins": "node scripts/verify-manifest-pins.mjs",
    "verify:manifest-sig": "node scripts/sign-manifest.mjs --verify",
    "verify:deps": "node scripts/verify-dep-pins.mjs",
    "test": "vitest run",
    "eval:device": "node scripts/eval-device.mjs",
    "eval:summary": "node scripts/eval-summary.mjs",
    "eval:local": "vitest run --config vitest.eval.config.mts",
    "pack:build": "node scripts/build-knowledge-pack.mjs",
    "pack:push": "node scripts/push-knowledge-pack.mjs",
    "test:components": "jest",
    "notices": "node scripts/third-party-notices.mjs",
    "test:all": "npm test && npm run test:components"
  },
  "private": true
