    "expo-haptics": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-linear-gradient": "58.0.3",
    "expo-local-authentication": "58.0.2",
    "expo-modules-core": "58.0.28",
    "expo-notifications": "58.1.7",
    "expo-pdf-text-extract": "1.1.0",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.21",
    "expo-speech": "58.0.3",
    "expo-splash-screen": "58.0.12",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "i18next": "26.4.5",
    "llama.rn": "0.13.0-rc.7",
    "nido-keyvault": "file:./modules/nido-keyvault",
    "nido-launch": "file:./modules/nido-launch",
    "nido-p2p": "file:./modules/nido-p2p",
    "nido-secure-dialog": "file:./modules/nido-secure-dialog",
    "nido-vectors": "file:./modules/nido-vectors",
    "qrcode": "1.5.4",
    "ram-monitor": "file:./modules/ram-monitor",
    "react": "19.3.0",
    "react-i18next": "17.0.16",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
